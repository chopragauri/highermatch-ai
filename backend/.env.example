DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hr_portal
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of email domains allowed to self-register as HR — @yahoo.com is
# mandatory for HR, every other domain registers as a candidate by default.
# This is the actual access control for HR accounts — see app/security.py.
ALLOWED_HR_EMAIL_DOMAINS=yahoo.com

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OPTIONAL — LLM resume parsing via OpenCode Go. When set, resumes are parsed by an
# LLM; when blank or unreachable, parsing falls back to the deterministic rule-based
# parser (app/parsing/rule_based.py), so the app works fully offline either way.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# OPTIONAL — Groq LLM enhancement. When set, match explanations are rewritten into
# natural language by Groq. Match SCORES are always computed locally and are never
# affected by this. Leave blank to run fully offline; any failure (no key, no network,
# rate limit, timeout) silently falls back to the deterministic template summary.
# Get a free key at https://console.groq.com
GROQ_API_KEY=
# Groq rotates model IDs — verify yours is live (client.models.list()) before changing.
GROQ_MODEL=openai/gpt-oss-20b
